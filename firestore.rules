rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    // Hardened global primitives
    function isSignedIn() {
      return request.auth != null;
    }

    function isBootstrapAdmin() {
      return isSignedIn() &&
        ('email' in request.auth.token) &&
        request.auth.token.email is string &&
        request.auth.token.email.lower() == 'j3je.prolinx@gmail.com';
    }

    function isAdmin() {
      return isSignedIn() && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        isBootstrapAdmin()
      );
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isOwnerIncoming() {
      return incoming().ownerId == request.auth.uid;
    }

    function isOwnerExisting() {
      return existing().ownerId == request.auth.uid;
    }

    function isValidDateString(d) {
      return d is string && d.size() == 10 && d.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
    }

    function isValidTimeString(t) {
      return t is string && t.size() == 5 && t.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$');
    }

    function isClassOwned(classId) {
      return exists(/databases/$(database)/documents/classes/$(classId)) &&
             get(/databases/$(database)/documents/classes/$(classId)).data.ownerId == request.auth.uid;
    }

    function isSubjectOwned(subjectId) {
      return exists(/databases/$(database)/documents/subjects/$(subjectId)) &&
             get(/databases/$(database)/documents/subjects/$(subjectId)).data.ownerId == request.auth.uid;
    }

    function isStudentOwned(studentId) {
      return exists(/databases/$(database)/documents/students/$(studentId)) &&
             get(/databases/$(database)/documents/students/$(studentId)).data.ownerId == request.auth.uid;
    }

    function isCategoryOwned(categoryId) {
      return exists(/databases/$(database)/documents/gradingCategories/$(categoryId)) &&
             get(/databases/$(database)/documents/gradingCategories/$(categoryId)).data.ownerId == request.auth.uid;
    }

    function isJournalOwnedAfter(journalId) {
      return existsAfter(/databases/$(database)/documents/teachingJournals/$(journalId)) &&
             getAfter(/databases/$(database)/documents/teachingJournals/$(journalId)).data.ownerId == request.auth.uid;
    }

    function isSlotOwned(slotId) {
      return exists(/databases/$(database)/documents/lessonSlots/$(slotId)) &&
             get(/databases/$(database)/documents/lessonSlots/$(slotId)).data.ownerId == request.auth.uid;
    }

    // Validation Blueprints
    function isValidSchoolClass(data) {
      return data.keys().hasAll(['ownerId', 'name', 'gradeLevel', 'academicYear', 'createdAt', 'updatedAt']) &&
             data.keys().hasOnly(['ownerId', 'name', 'gradeLevel', 'academicYear', 'homeroomTeacher', 'createdAt', 'updatedAt']) &&
             isValidId(data.ownerId) &&
             data.ownerId == request.auth.uid &&
             data.name is string && data.name.size() >= 1 && data.name.size() <= 60 &&
             data.gradeLevel is string && data.gradeLevel.size() >= 1 && data.gradeLevel.size() <= 40 &&
             data.academicYear is string && data.academicYear.size() >= 4 && data.academicYear.size() <= 20 &&
             (!('homeroomTeacher' in data) || (data.homeroomTeacher is string && data.homeroomTeacher.size() <= 100)) &&
             data.createdAt is timestamp &&
             data.updatedAt is timestamp;
    }

    function isValidSubject(data) {
      return data.keys().hasAll(['ownerId', 'code', 'name', 'createdAt', 'updatedAt']) &&
             data.keys().hasOnly(['ownerId', 'code', 'name', 'createdAt', 'updatedAt']) &&
             isValidId(data.ownerId) &&
             data.ownerId == request.auth.uid &&
             data.code is string && data.code.size() >= 1 && data.code.size() <= 24 &&
             data.name is string && data.name.size() >= 1 && data.name.size() <= 100 &&
             data.createdAt is timestamp &&
             data.updatedAt is timestamp;
    }

    function isValidStudent(data) {
      return data.keys().hasAll(['ownerId', 'nis', 'fullName', 'gender', 'classId', 'createdAt', 'updatedAt']) &&
             data.keys().hasOnly(['ownerId', 'nis', 'fullName', 'gender', 'classId', 'createdAt', 'updatedAt']) &&
             isValidId(data.ownerId) &&
             data.ownerId == request.auth.uid &&
             data.nis is string && data.nis.size() >= 1 && data.nis.size() <= 30 &&
             data.fullName is string && data.fullName.size() >= 1 && data.fullName.size() <= 120 &&
             data.gender in ['L', 'P'] &&
             isValidId(data.classId) &&
             data.createdAt is timestamp &&
             data.updatedAt is timestamp;
    }

    function isValidGradingCategory(data) {
      return data.keys().hasAll(['ownerId', 'subjectId', 'name', 'weight', 'createdAt', 'updatedAt']) &&
             data.keys().hasOnly(['ownerId', 'classId', 'subjectId', 'name', 'weight', 'createdAt', 'updatedAt']) &&
             isValidId(data.ownerId) &&
             data.ownerId == request.auth.uid &&
             (!('classId' in data) || isValidId(data.classId)) &&
             isValidId(data.subjectId) &&
             data.name is string && data.name.size() >= 1 && data.name.size() <= 60 &&
             data.weight is number && data.weight >= 0 && data.weight <= 100 &&
             data.createdAt is timestamp &&
             data.updatedAt is timestamp;
    }

    function isValidAcademicGrade(data) {
      return data.keys().hasAll(['ownerId', 'date', 'classId', 'subjectId', 'categoryId', 'studentId', 'score', 'createdAt', 'updatedAt']) &&
             data.keys().hasOnly(['ownerId', 'date', 'classId', 'subjectId', 'categoryId', 'studentId', 'score', 'assessmentType', 'chapter', 'assessmentOrder', 'assessmentLabel', 'notes', 'createdAt', 'updatedAt']) &&
             isValidId(data.ownerId) &&
             data.ownerId == request.auth.uid &&
             isValidDateString(data.date) &&
             isValidId(data.classId) &&
             isValidId(data.subjectId) &&
             isValidId(data.categoryId) &&
             isValidId(data.studentId) &&
             data.score is number && data.score >= 0 && data.score <= 100 &&
             (!('assessmentType' in data) || data.assessmentType in ['formatif', 'sumatif']) &&
             (!('chapter' in data) || (data.chapter is string && data.chapter.size() <= 60)) &&
             (!('assessmentOrder' in data) || (data.assessmentOrder is number && data.assessmentOrder >= 1 && data.assessmentOrder <= 20)) &&
             (!('assessmentLabel' in data) || (data.assessmentLabel is string && data.assessmentLabel.size() <= 60)) &&
             (!('notes' in data) || (data.notes is string && data.notes.size() <= 300)) &&
             data.createdAt is timestamp &&
             data.updatedAt is timestamp;
    }

    function isValidAttitudeAssessment(data) {
      return data.keys().hasAll(['ownerId', 'date', 'classId', 'subjectId', 'studentId', 'aspect', 'predicate', 'createdAt', 'updatedAt']) &&
             data.keys().hasOnly(['ownerId', 'date', 'classId', 'subjectId', 'studentId', 'aspect', 'predicate', 'incidentType', 'notes', 'createdAt', 'updatedAt']) &&
             isValidId(data.ownerId) &&
             data.ownerId == request.auth.uid &&
             isValidDateString(data.date) &&
             isValidId(data.classId) &&
             isValidId(data.subjectId) &&
             isValidId(data.studentId) &&
             data.aspect is string && data.aspect.size() >= 1 && data.aspect.size() <= 60 &&
             data.predicate in ['Sangat Baik', 'Baik', 'Cukup', 'Perlu Bimbingan'] &&
             (!('incidentType' in data) || data.incidentType in ['Netral', 'Positif', 'Negatif']) &&
             (!('notes' in data) || (data.notes is string && data.notes.size() <= 500)) &&
             data.createdAt is timestamp &&
             data.updatedAt is timestamp;
    }

    function isValidTeachingJournal(data) {
      return data.keys().hasAll(['ownerId', 'date', 'lessonHours', 'classId', 'subjectId', 'topic', 'presentCount', 'sickCount', 'permissionCount', 'absentCount', 'createdAt', 'updatedAt']) &&
             data.keys().hasOnly(['ownerId', 'date', 'lessonHours', 'classId', 'subjectId', 'topic', 'learningObjectives', 'presentCount', 'sickCount', 'permissionCount', 'absentCount', 'reflection', 'createdAt', 'updatedAt']) &&
             isValidId(data.ownerId) &&
             data.ownerId == request.auth.uid &&
             isValidDateString(data.date) &&
             data.lessonHours is string && data.lessonHours.size() >= 1 && data.lessonHours.size() <= 60 &&
             isValidId(data.classId) &&
             isValidId(data.subjectId) &&
             data.topic is string && data.topic.size() >= 1 && data.topic.size() <= 200 &&
             (!('learningObjectives' in data) || (data.learningObjectives is string && data.learningObjectives.size() <= 1000)) &&
             data.presentCount is number && data.presentCount >= 0 && data.presentCount <= 200 &&
             data.sickCount is number && data.sickCount >= 0 && data.sickCount <= 200 &&
             data.permissionCount is number && data.permissionCount >= 0 && data.permissionCount <= 200 &&
             data.absentCount is number && data.absentCount >= 0 && data.absentCount <= 200 &&
             (!('reflection' in data) || (data.reflection is string && data.reflection.size() <= 1000)) &&
             data.createdAt is timestamp &&
             data.updatedAt is timestamp;
    }

    function isValidStudentAttendance(data) {
      return data.keys().hasAll(['ownerId', 'journalId', 'date', 'classId', 'subjectId', 'studentId', 'status', 'createdAt', 'updatedAt']) &&
             data.keys().hasOnly(['ownerId', 'journalId', 'date', 'classId', 'subjectId', 'studentId', 'status', 'createdAt', 'updatedAt']) &&
             isValidId(data.ownerId) &&
             data.ownerId == request.auth.uid &&
             isValidId(data.journalId) &&
             isValidDateString(data.date) &&
             isValidId(data.classId) &&
             isValidId(data.subjectId) &&
             isValidId(data.studentId) &&
             data.status in ['Hadir', 'Sakit', 'Izin', 'Alfa'] &&
             data.createdAt is timestamp &&
             data.updatedAt is timestamp;
    }

    function isValidLessonSlot(data) {
      return data.keys().hasAll(['ownerId', 'label', 'startTime', 'endTime', 'order', 'createdAt', 'updatedAt']) &&
             data.keys().hasOnly(['ownerId', 'label', 'startTime', 'endTime', 'order', 'createdAt', 'updatedAt']) &&
             isValidId(data.ownerId) &&
             data.ownerId == request.auth.uid &&
             data.label is string && data.label.size() >= 1 && data.label.size() <= 60 &&
             isValidTimeString(data.startTime) &&
             isValidTimeString(data.endTime) &&
             data.order is number && data.order >= 0 && data.order <= 100 &&
             data.createdAt is timestamp &&
             data.updatedAt is timestamp;
    }

    function isValidTeachingSchedule(data) {
      return data.keys().hasAll(['ownerId', 'dayOfWeek', 'slotId', 'classId', 'subjectId', 'createdAt', 'updatedAt']) &&
             data.keys().hasOnly(['ownerId', 'dayOfWeek', 'slotId', 'classId', 'subjectId', 'createdAt', 'updatedAt']) &&
             isValidId(data.ownerId) &&
             data.ownerId == request.auth.uid &&
             data.dayOfWeek is number && data.dayOfWeek >= 0 && data.dayOfWeek <= 6 &&
             isValidId(data.slotId) &&
             isValidId(data.classId) &&
             isValidId(data.subjectId) &&
             data.createdAt is timestamp &&
             data.updatedAt is timestamp;
    }

    function isValidUserProfile(data, userId) {
      return data.keys().hasAll(['uid', 'email', 'displayName', 'role', 'status', 'createdAt', 'updatedAt']) &&
             data.keys().hasOnly(['uid', 'email', 'displayName', 'role', 'status', 'nip', 'subjectSpecialty', 'createdAt', 'updatedAt']) &&
             isValidId(data.uid) &&
             data.uid == userId &&
             data.email is string && data.email.size() >= 3 && data.email.size() <= 160 &&
             data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 120 &&
             data.role in ['admin', 'guru'] &&
             data.status in ['active', 'inactive'] &&
             (!('nip' in data) || (data.nip is string && data.nip.size() <= 40)) &&
             (!('subjectSpecialty' in data) || (data.subjectSpecialty is string && data.subjectSpecialty.size() <= 120)) &&
             data.createdAt is timestamp &&
             data.updatedAt is timestamp;
    }

    function isValidAdminDoc(data, userId) {
      return data.keys().hasAll(['uid', 'email', 'grantedBy', 'createdAt', 'updatedAt']) &&
             data.keys().hasOnly(['uid', 'email', 'grantedBy', 'createdAt', 'updatedAt']) &&
             isValidId(data.uid) &&
             data.uid == userId &&
             data.email is string && data.email.size() >= 3 && data.email.size() <= 160 &&
             isValidId(data.grantedBy) &&
             data.grantedBy == request.auth.uid &&
             data.createdAt is timestamp &&
             data.updatedAt is timestamp;
    }

    // 1. Classes
    match /classes/{classId} {
      allow get: if isSignedIn() && isValidId(classId) && isOwnerExisting();
      allow list: if isSignedIn() && isOwnerExisting();
      allow create: if isSignedIn() && isValidId(classId) && isValidSchoolClass(incoming()) &&
                       incoming().createdAt == request.time && incoming().updatedAt == request.time;
      allow update: if isSignedIn() && isValidId(classId) && isValidSchoolClass(incoming()) &&
                       isOwnerExisting() && isOwnerIncoming() &&
                       incoming().createdAt == existing().createdAt &&
                       incoming().updatedAt == request.time &&
                       incoming().diff(existing()).affectedKeys().hasOnly(['name', 'gradeLevel', 'academicYear', 'homeroomTeacher', 'updatedAt']);
      allow delete: if isSignedIn() && isValidId(classId) && isOwnerExisting();
    }

    // 2. Subjects
    match /subjects/{subjectId} {
      allow get: if isSignedIn() && isValidId(subjectId) && isOwnerExisting();
      allow list: if isSignedIn() && isOwnerExisting();
      allow create: if isSignedIn() && isValidId(subjectId) && isValidSubject(incoming()) &&
                       incoming().createdAt == request.time && incoming().updatedAt == request.time;
      allow update: if isSignedIn() && isValidId(subjectId) && isValidSubject(incoming()) &&
                       isOwnerExisting() && isOwnerIncoming() &&
                       incoming().createdAt == existing().createdAt &&
                       incoming().updatedAt == request.time &&
                       incoming().diff(existing()).affectedKeys().hasOnly(['code', 'name', 'updatedAt']);
      allow delete: if isSignedIn() && isValidId(subjectId) && isOwnerExisting();
    }

    // 3. Students
    match /students/{studentId} {
      allow get: if isSignedIn() && isValidId(studentId) && isOwnerExisting();
      allow list: if isSignedIn() && isOwnerExisting();
      allow create: if isSignedIn() && isValidId(studentId) && isValidStudent(incoming()) &&
                       incoming().createdAt == request.time && incoming().updatedAt == request.time &&
                       isClassOwned(incoming().classId);
      allow update: if isSignedIn() && isValidId(studentId) && isValidStudent(incoming()) &&
                       isOwnerExisting() && isOwnerIncoming() &&
                       incoming().createdAt == existing().createdAt &&
                       incoming().updatedAt == request.time &&
                       isClassOwned(incoming().classId) &&
                       incoming().diff(existing()).affectedKeys().hasOnly(['nis', 'fullName', 'gender', 'classId', 'updatedAt']);
      allow delete: if isSignedIn() && isValidId(studentId) && isOwnerExisting();
    }

    // 4. Grading Categories
    match /gradingCategories/{categoryId} {
      allow get: if isSignedIn() && isValidId(categoryId) && isOwnerExisting();
      allow list: if isSignedIn() && isOwnerExisting();
      allow create: if isSignedIn() && isValidId(categoryId) && isValidGradingCategory(incoming()) &&
                       incoming().createdAt == request.time && incoming().updatedAt == request.time &&
                       (!('classId' in incoming()) || isClassOwned(incoming().classId)) &&
                       isSubjectOwned(incoming().subjectId);
      allow update: if isSignedIn() && isValidId(categoryId) && isValidGradingCategory(incoming()) &&
                       isOwnerExisting() && isOwnerIncoming() &&
                       incoming().createdAt == existing().createdAt &&
                       incoming().updatedAt == request.time &&
                       (!('classId' in incoming()) || isClassOwned(incoming().classId)) &&
                       isSubjectOwned(incoming().subjectId) &&
                       incoming().diff(existing()).affectedKeys().hasOnly(['classId', 'subjectId', 'name', 'weight', 'updatedAt']);
      allow delete: if isSignedIn() && isValidId(categoryId) && isOwnerExisting();
    }

    // 5. Academic Grades
    match /academicGrades/{gradeId} {
      allow get: if isSignedIn() && isValidId(gradeId) && isOwnerExisting();
      allow list: if isSignedIn() && isOwnerExisting();
      allow create: if isSignedIn() && isValidId(gradeId) && isValidAcademicGrade(incoming()) &&
                       incoming().createdAt == request.time && incoming().updatedAt == request.time &&
                       isClassOwned(incoming().classId) && isSubjectOwned(incoming().subjectId) &&
                       isCategoryOwned(incoming().categoryId) && isStudentOwned(incoming().studentId);
      allow update: if isSignedIn() && isValidId(gradeId) && isValidAcademicGrade(incoming()) &&
                       isOwnerExisting() && isOwnerIncoming() &&
                       incoming().createdAt == existing().createdAt &&
                       incoming().updatedAt == request.time &&
                       isClassOwned(incoming().classId) && isSubjectOwned(incoming().subjectId) &&
                       isCategoryOwned(incoming().categoryId) && isStudentOwned(incoming().studentId) &&
                       incoming().diff(existing()).affectedKeys().hasOnly(['date', 'classId', 'subjectId', 'categoryId', 'studentId', 'score', 'assessmentType', 'chapter', 'assessmentOrder', 'assessmentLabel', 'notes', 'updatedAt']);
      allow delete: if isSignedIn() && isValidId(gradeId) && isOwnerExisting();
    }

    // 6. Attitude Assessments
    match /attitudeAssessments/{assessmentId} {
      allow get: if isSignedIn() && isValidId(assessmentId) && isOwnerExisting();
      allow list: if isSignedIn() && isOwnerExisting();
      allow create: if isSignedIn() && isValidId(assessmentId) && isValidAttitudeAssessment(incoming()) &&
                       incoming().createdAt == request.time && incoming().updatedAt == request.time &&
                       isClassOwned(incoming().classId) && isSubjectOwned(incoming().subjectId) &&
                       isStudentOwned(incoming().studentId);
      allow update: if isSignedIn() && isValidId(assessmentId) && isValidAttitudeAssessment(incoming()) &&
                       isOwnerExisting() && isOwnerIncoming() &&
                       incoming().createdAt == existing().createdAt &&
                       incoming().updatedAt == request.time &&
                       isClassOwned(incoming().classId) && isSubjectOwned(incoming().subjectId) &&
                       isStudentOwned(incoming().studentId) &&
                       incoming().diff(existing()).affectedKeys().hasOnly(['date', 'classId', 'subjectId', 'studentId', 'aspect', 'predicate', 'incidentType', 'notes', 'updatedAt']);
      allow delete: if isSignedIn() && isValidId(assessmentId) && isOwnerExisting();
    }

    // 7. Teaching Journals
    match /teachingJournals/{journalId} {
      allow get: if isSignedIn() && isValidId(journalId) && isOwnerExisting();
      allow list: if isSignedIn() && isOwnerExisting();
      allow create: if isSignedIn() && isValidId(journalId) && isValidTeachingJournal(incoming()) &&
                       incoming().createdAt == request.time && incoming().updatedAt == request.time &&
                       isClassOwned(incoming().classId) && isSubjectOwned(incoming().subjectId);
      allow update: if isSignedIn() && isValidId(journalId) && isValidTeachingJournal(incoming()) &&
                       isOwnerExisting() && isOwnerIncoming() &&
                       incoming().createdAt == existing().createdAt &&
                       incoming().updatedAt == request.time &&
                       isClassOwned(incoming().classId) && isSubjectOwned(incoming().subjectId) &&
                       incoming().diff(existing()).affectedKeys().hasOnly(['date', 'lessonHours', 'classId', 'subjectId', 'topic', 'learningObjectives', 'presentCount', 'sickCount', 'permissionCount', 'absentCount', 'reflection', 'updatedAt']);
      allow delete: if isSignedIn() && isValidId(journalId) && isOwnerExisting();
    }

    // 8. Student Attendance
    match /studentAttendance/{attendanceId} {
      allow get: if isSignedIn() && isValidId(attendanceId) && isOwnerExisting();
      allow list: if isSignedIn() && isOwnerExisting();
      allow create: if isSignedIn() && isValidId(attendanceId) && isValidStudentAttendance(incoming()) &&
                       incoming().createdAt == request.time && incoming().updatedAt == request.time &&
                       isJournalOwnedAfter(incoming().journalId) &&
                       isClassOwned(incoming().classId) && isSubjectOwned(incoming().subjectId) &&
                       isStudentOwned(incoming().studentId);
      allow update: if isSignedIn() && isValidId(attendanceId) && isValidStudentAttendance(incoming()) &&
                       isOwnerExisting() && isOwnerIncoming() &&
                       incoming().createdAt == existing().createdAt &&
                       incoming().updatedAt == request.time &&
                       isJournalOwnedAfter(incoming().journalId) &&
                       isClassOwned(incoming().classId) && isSubjectOwned(incoming().subjectId) &&
                       isStudentOwned(incoming().studentId) &&
                       incoming().diff(existing()).affectedKeys().hasOnly(['journalId', 'date', 'classId', 'subjectId', 'studentId', 'status', 'updatedAt']);
      allow delete: if isSignedIn() && isValidId(attendanceId) && isOwnerExisting();
    }

    // 9. Lesson Slots
    match /lessonSlots/{slotId} {
      allow get: if isSignedIn() && isValidId(slotId) && isOwnerExisting();
      allow list: if isSignedIn() && isOwnerExisting();
      allow create: if isSignedIn() && isValidId(slotId) && isValidLessonSlot(incoming()) &&
                       incoming().createdAt == request.time && incoming().updatedAt == request.time;
      allow update: if isSignedIn() && isValidId(slotId) && isValidLessonSlot(incoming()) &&
                       isOwnerExisting() && isOwnerIncoming() &&
                       incoming().createdAt == existing().createdAt &&
                       incoming().updatedAt == request.time &&
                       incoming().diff(existing()).affectedKeys().hasOnly(['label', 'startTime', 'endTime', 'order', 'updatedAt']);
      allow delete: if isSignedIn() && isValidId(slotId) && isOwnerExisting();
    }

    // 10. Teaching Schedules
    match /teachingSchedules/{scheduleId} {
      allow get: if isSignedIn() && isValidId(scheduleId) && isOwnerExisting();
      allow list: if isSignedIn() && isOwnerExisting();
      allow create: if isSignedIn() && isValidId(scheduleId) && isValidTeachingSchedule(incoming()) &&
                       incoming().createdAt == request.time && incoming().updatedAt == request.time &&
                       isSlotOwned(incoming().slotId) && isClassOwned(incoming().classId) && isSubjectOwned(incoming().subjectId);
      allow update: if isSignedIn() && isValidId(scheduleId) && isValidTeachingSchedule(incoming()) &&
                       isOwnerExisting() && isOwnerIncoming() &&
                       incoming().createdAt == existing().createdAt &&
                       incoming().updatedAt == request.time &&
                       isSlotOwned(incoming().slotId) && isClassOwned(incoming().classId) && isSubjectOwned(incoming().subjectId) &&
                       incoming().diff(existing()).affectedKeys().hasOnly(['dayOfWeek', 'slotId', 'classId', 'subjectId', 'updatedAt']);
      allow delete: if isSignedIn() && isValidId(scheduleId) && isOwnerExisting();
    }

    // 11. User Profiles (Multi-User RBAC)
    match /users/{userId} {
      allow get: if isSignedIn() && isValidId(userId) && (request.auth.uid == userId || isAdmin());
      allow list: if isSignedIn() && (existing().uid == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && isValidId(userId) && isValidUserProfile(incoming(), userId) &&
                       incoming().createdAt == request.time && incoming().updatedAt == request.time && (
                         isAdmin() ||
                         (
                           request.auth.uid == userId &&
                           incoming().role == 'guru' &&
                           incoming().status == 'active'
                         )
                       );
      allow update: if isSignedIn() && isValidId(userId) && isValidUserProfile(incoming(), userId) &&
                       incoming().uid == existing().uid &&
                       incoming().email == existing().email &&
                       incoming().createdAt == existing().createdAt &&
                       incoming().updatedAt == request.time && (
                         (
                           isAdmin() &&
                           incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'role', 'status', 'nip', 'subjectSpecialty', 'updatedAt'])
                         ) ||
                         (
                           request.auth.uid == userId &&
                           incoming().role == existing().role &&
                           incoming().status == existing().status &&
                           incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'nip', 'subjectSpecialty', 'updatedAt'])
                         )
                       );
      allow delete: if isSignedIn() && isValidId(userId) && isAdmin() && userId != request.auth.uid;
    }

    // 12. Admin Role Registry
    match /admins/{userId} {
      allow get: if isSignedIn() && isValidId(userId) && (request.auth.uid == userId || isAdmin());
      allow list: if isSignedIn() && (existing().uid == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && isValidId(userId) && isValidAdminDoc(incoming(), userId) &&
                       incoming().createdAt == request.time && incoming().updatedAt == request.time && (
                         isAdmin() ||
                         (request.auth.uid == userId && isBootstrapAdmin())
                       );
      allow update: if isSignedIn() && isValidId(userId) && isValidAdminDoc(incoming(), userId) &&
                       incoming().uid == existing().uid &&
                       incoming().email == existing().email &&
                       incoming().createdAt == existing().createdAt &&
                       incoming().updatedAt == request.time &&
                       isAdmin() &&
                       incoming().diff(existing()).affectedKeys().hasOnly(['grantedBy', 'updatedAt']);
      allow delete: if isSignedIn() && isValidId(userId) && isAdmin() && userId != request.auth.uid;
    }
  }
}
